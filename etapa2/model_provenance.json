 "findings": [
  {
   "id": "F-P2T-01",
   "descripcion": "El gate j del .tem coincide con el gate j+1 de la tabla del lector.",
   "evidencia": "Emparejamiento por tiempo y amplitud en los 6 sondeos; el .tem exporta los gates 2..n+1 de la tabla del lector."
  },
  {
   "id": "F-P2T-02",
   "descripcion": "t_parser_ms no es un reloj independiente: esta desalineado respecto de la amplitud de su propia fila desde el gate 4.",
   "evidencia": "La diferencia relativa maxima entre t_ms y t_parser_ms es 0.2597 global (SER-09=0.2247; SER-10=0.2500; SER-11=0.2500; SER-12=0.2439; SER-13=0.2532; SER-14=0.2597). El .tem coincide con t_ms en el desplazamiento +1. clock_max_relative_pct del dosier (35.7-40.6%) mide el cambio de respuesta TEM al sustituir t_ms por t_parser_ms; es un artefacto de alineacion de tablas, no una deriva de reloj demostrada."
  },
  {
   "id": "F-P2T-03",
   "descripcion": "La amplitud .tem y la amplitud del lector difieren dentro de la ventana util.",
   "evidencia": "Maxima diferencia relativa por sondeo: SER-09=0.038; SER-10=0.078; SER-11=0.073; SER-12=0.107; SER-13=0.050; SER-14=0.128. La inversion uso la tabla del lector; la diferencia es un sesgo sistematico no incluido en C_d."
  },
  {
   "id": "F-P2T-04",
   "descripcion": "Los 18 modelos son escenarios, no un posterior probabilistico.",
   "evidencia": "6 modelos base + 12 modelos de estabilidad; regularization_lambda 1.0-4.0; wrms_log 0.25-1.35; sin covarianza posterior."
  },
  {
   "id": "F-P2T-05",
   "descripcion": "El rango efectivo del Jacobiano TEM es bajo y el resultado de sensibilidad compartida depende del umbral de rango.",
   "evidencia": "Rango efectivo al 1%: SER-09=4; SER-10=4; SER-11=4; SER-12=4; SER-13=4; SER-14=4. Se reportan umbrales 1%, 0.1% y 0.01%."
  },
  {
   "id": "F-P2T-06",
   "descripcion": "La DOI no esta validada; solo existe una DOI operativa creible.",
   "evidencia": "DOI_validated_m vacia en los 6 sondeos; DOI_operativa_creible_m 100 m (SER-09/10) y 175 m (SER-11..14)."
  },
  {
   "id": "F-P2T-07",
   "descripcion": "10 kHz coincide con el empalme de calibracion D1.",
   "evidencia": "El punto 10000 Hz se conserva como escenario separado y queda no_evaluado."
  },
  {
   "id": "F-P2T-08",
   "descripcion": "No hay vinculo TEM-ARMT verificado.",
   "evidencia": "B-P0-03 abierto; tem_link.status=no_verificado en los 15 registros y en los 6 sondeos. tem_amt_support.csv queda no_evaluado."
  }
 ],
